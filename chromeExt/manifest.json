{
    "manifest_version": 3,
    "name": "KeyShield",
    "version": "1.1",
    "description": "Detect and secure hardcoded secrets in ChatGPT, Claude, and Gemini prompts.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/keyshield.png",
            "32": "icons/keyshield.png",
            "48": "icons/keyshield.png",
            "128": "icons/keyshield.png"
        }
    },
    "icons": {
        "16": "icons/keyshield.png",
        "32": "icons/keyshield.png",
        "48": "icons/keyshield.png",
        "128": "icons/keyshield.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*",
                "https://chat.openai.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "commands": {
        "run-scan": {
            "suggested_key": {
                "default": "Ctrl+Shift+K",
                "mac": "Command+Shift+K"
            }
        }
    }
}